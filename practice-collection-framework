Java Collections Framework – Part 1: ArrayList (All Important Methods)
import java.util.*;

public class ArrayListMethodsDemo {

    public static void main(String[] args) {

        // Create ArrayList
        ArrayList<String> list = new ArrayList<>();

        // 1. add()
        list.add("Java");
        list.add("Python");
        list.add("C++");
        System.out.println("1. add() : " + list);

        // 2. add(index, element)
        list.add(1, "Spring");
        System.out.println("2. add(index, element) : " + list);

        // 3. addAll()
        ArrayList<String> list2 = new ArrayList<>();
        list2.add("HTML");
        list2.add("CSS");

        list.addAll(list2);
        System.out.println("3. addAll() : " + list);

        // 4. get()
        System.out.println("4. get(2) : " + list.get(2));

        // 5. set()
        list.set(2, "JavaScript");
        System.out.println("5. set() : " + list);

        // 6. remove(index)
        list.remove(3);
        System.out.println("6. remove(index) : " + list);

        // 7. remove(object)
        list.remove("HTML");
        System.out.println("7. remove(object) : " + list);

        // 8. removeAll()
        ArrayList<String> removeList = new ArrayList<>();
        removeList.add("CSS");

        list.removeAll(removeList);
        System.out.println("8. removeAll() : " + list);

        // 9. retainAll()
        ArrayList<String> retainList = new ArrayList<>();
        retainList.add("Java");
        retainList.add("Spring");

        list.retainAll(retainList);
        System.out.println("9. retainAll() : " + list);

        // Add more elements
        list.add("Python");
        list.add("Java");
        list.add("C++");

        System.out.println("Updated List : " + list);

        // 10. contains()
        System.out.println("10. contains(Java) : " + list.contains("Java"));

        // 11. containsAll()
        ArrayList<String> check = new ArrayList<>();
        check.add("Java");
        check.add("Python");

        System.out.println("11. containsAll() : " + list.containsAll(check));

        // 12. indexOf()
        System.out.println("12. indexOf(Java) : " + list.indexOf("Java"));

        // 13. lastIndexOf()
        System.out.println("13. lastIndexOf(Java) : " + list.lastIndexOf("Java"));

        // 14. size()
        System.out.println("14. size() : " + list.size());

        // 15. isEmpty()
        System.out.println("15. isEmpty() : " + list.isEmpty());

        // 16. iterator()
        System.out.print("16. iterator() : ");
        Iterator<String> itr = list.iterator();

        while (itr.hasNext()) {
            System.out.print(itr.next() + " ");
        }
        System.out.println();

        // 17. listIterator()
        System.out.print("17. listIterator() : ");
        ListIterator<String> litr = list.listIterator();

        while (litr.hasNext()) {
            System.out.print(litr.next() + " ");
        }
        System.out.println();

        // 18. subList()
        System.out.println("18. subList(1,3) : " + list.subList(1, 3));

        // 19. toArray()
        Object[] arr = list.toArray();

        System.out.print("19. toArray() : ");
        for (Object obj : arr) {
            System.out.print(obj + " ");
        }
        System.out.println();

        // 20. sort()
        Collections.sort(list);
        System.out.println("20. sort() : " + list);

        // 21. replaceAll()
        list.replaceAll(str -> str.toUpperCase());
        System.out.println("21. replaceAll() : " + list);

        // 22. clear()
        list.clear();
        System.out.println("22. clear() : " + list);

        // 23. isEmpty() after clear
        System.out.println("23. isEmpty() : " + list.isEmpty());
    }
}
