Java Collections Framework – Part 2: LinkedList & Deque (All Important Methods)
import java.util.*;

public class LinkedListDemo {

    public static void main(String[] args) {

        LinkedList<String> list = new LinkedList<>();

        // 1. add()
        list.add("Java");
        list.add("Python");
        list.add("C++");
        System.out.println("1. add() : " + list);

        // 2. addFirst()
        list.addFirst("HTML");
        System.out.println("2. addFirst() : " + list);

        // 3. addLast()
        list.addLast("Spring");
        System.out.println("3. addLast() : " + list);

        // 4. offer()
        list.offer("React");
        System.out.println("4. offer() : " + list);

        // 5. offerFirst()
        list.offerFirst("CSS");
        System.out.println("5. offerFirst() : " + list);

        // 6. offerLast()
        list.offerLast("Angular");
        System.out.println("6. offerLast() : " + list);

        // 7. getFirst()
        System.out.println("7. getFirst() : " + list.getFirst());

        // 8. getLast()
        System.out.println("8. getLast() : " + list.getLast());

        // 9. peek()
        System.out.println("9. peek() : " + list.peek());

        // 10. peekFirst()
        System.out.println("10. peekFirst() : " + list.peekFirst());

        // 11. peekLast()
        System.out.println("11. peekLast() : " + list.peekLast());

        // 12. element()
        System.out.println("12. element() : " + list.element());

        // 13. remove()
        list.remove();
        System.out.println("13. remove() : " + list);

        // 14. removeFirst()
        list.removeFirst();
        System.out.println("14. removeFirst() : " + list);

        // 15. removeLast()
        list.removeLast();
        System.out.println("15. removeLast() : " + list);

        // 16. poll()
        System.out.println("16. poll() : " + list.poll());
        System.out.println(list);

        // 17. pollFirst()
        System.out.println("17. pollFirst() : " + list.pollFirst());
        System.out.println(list);

        // 18. pollLast()
        System.out.println("18. pollLast() : " + list.pollLast());
        System.out.println(list);

        // Add data again
        list.add("Java");
        list.add("Python");
        list.add("C++");

        // 19. push()
        list.push("Stack");
        System.out.println("19. push() : " + list);

        // 20. pop()
        System.out.println("20. pop() : " + list.pop());
        System.out.println(list);

        // 21. contains()
        System.out.println("21. contains(Java) : " + list.contains("Java"));

        // 22. size()
        System.out.println("22. size() : " + list.size());

        // 23. isEmpty()
        System.out.println("23. isEmpty() : " + list.isEmpty());

        // 24. iterator()
        System.out.print("24. iterator() : ");
        Iterator<String> itr = list.iterator();

        while (itr.hasNext()) {
            System.out.print(itr.next() + " ");
        }
        System.out.println();

        // 25. descendingIterator()
        System.out.print("25. descendingIterator() : ");
        Iterator<String> ditr = list.descendingIterator();

        while (ditr.hasNext()) {
            System.out.print(ditr.next() + " ");
        }
        System.out.println();

        // 26. clear()
        list.clear();
        System.out.println("26. clear() : " + list);

        // 27. isEmpty()
        System.out.println("27. isEmpty() : " + list.isEmpty());
    }
}
