        d.print(12.5);
    }
}

5. Generic Array
---------------------------------------------------------------
class PrintArray<T> {

    void display(T[] arr) {
        for (T i : arr) {
            System.out.print(i + " ");
        }
    }
}

public class Main {
    public static void main(String[] args) {

        Integer[] num = {1,2,3,4};
        String[] name = {"A","B","C"};

        PrintArray<Integer> p1 = new PrintArray<>();
        p1.display(num);

        System.out.println();

        PrintArray<String> p2 = new PrintArray<>();
        p2.display(name);
    }
}

6. Generic Stack
---------------------------------------------------------------
import java.util.*;

class StackDemo<T> {

    Stack<T> stack = new Stack<>();

    void push(T value) {
        stack.push(value);
    }

    T pop() {
        return stack.pop();
    }
}

public class Main {

    public static void main(String[] args) {

        StackDemo<String> s = new StackDemo<>();

        s.push("Java");
        s.push("Python");

        System.out.println(s.pop());
    }
}

