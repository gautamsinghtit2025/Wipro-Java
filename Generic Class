2. Generic Class with getter & setter
-------------------------------------------------------------
class Student<T> {
    private T data;

    public void setData(T data) {
        this.data = data;
    }

    public T getData() {
        return data;
    }
}

public class Main {
    public static void main(String[] args) {
        Student<String> s = new Student<>();
        s.setData("Amit");

        System.out.println(s.getData());
    }
}

3. Generic class with two type parameter
---------------------------------------------------------------
class Pair<K, V> {
    K key;
    V value;

    Pair(K key, V value) {
        this.key = key;
        this.value = value;
    }

    void show() {
        System.out.println(key + " : " + value);
    }
}

public class Main {
    public static void main(String[] args) {
        Pair<Integer, String> p = new Pair<>(101, "Rahul");
        p.show();
    }
}

